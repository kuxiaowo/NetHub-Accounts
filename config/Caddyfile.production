nethub.wiki {
    @moderation_private path /internal/moderation /internal/moderation/*
    handle @moderation_private {
        respond 404
    }

    @client_info path /__nethub/client /__nethub/client.js /__nethub/privacy
    handle @client_info {
        request_body {
            max_size 16KB
        }
        reverse_proxy 127.0.0.1:3400 {
            header_up X-Nethub-Site-Host {host}
            header_down -X-Nethub-Client-Info
            header_down -X-Nethub-Browser-Id
            header_down -X-Nethub-User-Sub
        }
    }
    log {
        output file /var/log/caddy/access.json {
            roll_size 100MiB
            roll_keep 40
            roll_keep_for 720h
        }
        format filter {
            fields {
                request>headers>Cookie delete
                request>headers>Authorization delete
                request>headers>Proxy-Authorization delete
                resp_headers>Set-Cookie delete
                request>headers>X-Nethub-User-Sub delete
                request>uri regexp "[?].*$" ""
                request>headers>Referer regexp "[?].*$" ""
            }
            wrap json
        }
    }
    request_header -X-Nethub-User-Sub
    log_append user_sub {rp.header.X-Nethub-User-Sub}
    log_append browser_id {http.request.cookie.nethub_browser}
    log_append assigned_browser_id {rp.header.X-Nethub-Browser-Id}
    log_append client_info {rp.header.X-Nethub-Client-Info}
    request_header -X-Nethub-Site-Host
    request_header -X-Nethub-Client-Info
    request_header -X-Nethub-Browser-Id
    header Accept-CH "Sec-CH-UA-Arch, Sec-CH-UA-Bitness, Sec-CH-UA-Model, Sec-CH-UA-Platform-Version, Sec-CH-UA-Full-Version-List, Sec-CH-UA-WoW64, Sec-CH-UA-Form-Factors"
    encode zstd gzip
    handle /media/* {
        reverse_proxy 127.0.0.1:3100 {
            header_up -X-Nethub-User-Sub
            header_down -X-Nethub-User-Sub
        }
    }
    @wikiapi path /api /api/*
    handle @wikiapi {
        reverse_proxy 127.0.0.1:3100 {
            header_up -X-Nethub-User-Sub
            header_down -X-Nethub-User-Sub
        }
    }
    handle {
        reverse_proxy 127.0.0.1:3200 {
        header_up -X-Nethub-User-Sub
        header_down -X-Nethub-User-Sub
    }
    }
}
