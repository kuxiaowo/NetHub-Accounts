# Service. Keep the host on 127.0.0.1 when Caddy or Nginx is in front.
ACCOUNTS_HOST=127.0.0.1
ACCOUNTS_PORT=3400
ACCOUNTS_ISSUER=https://auth.nethub.wiki

# The install script generates a random value when this is empty.
ACCOUNTS_SECRET_KEY=

# SQLite is retained for local development and tests. Production defaults to
DATABASE_URL=sqlite:///data/accounts.sqlite3
ACCOUNTS_DATABASE_BACKEND=sqlite

# Central avatar storage. Uploaded originals are discarded after a 512px WebP
# has been decoded, validated and compressed.
AVATAR_UPLOAD_DIR=data/uploads/avatars
AVATAR_UPLOAD_MAX_MB=5
AVATAR_MAX_STORED_KB=256
AVATAR_SIZE_PX=512
AVATAR_WEBP_QUALITY=85
AVATAR_STORAGE_BACKEND=r2
AVATAR_R2_GATEWAY_URL=https://wiki-media.nethub.wiki
AVATAR_R2_HMAC_SECRET=
AVATAR_R2_TIMEOUT=10

# The install script creates this RSA private key when it does not exist.
OIDC_SIGNING_KEY_PATH=data/oidc-rs256.pem

# Keep registration disabled while importing existing accounts. Enable it
# before the TodoList cutover maintenance window.
REGISTRATION_ENABLED=false

# Required for production login and registration. Keep the secret on the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SESSION_COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1
SESSION_IDLE_SECONDS=604800
SESSION_ABSOLUTE_SECONDS=2592000
OAUTH_TOKEN_EXPIRES_SECONDS=300
LOGIN_LIMIT_PER_15_MINUTES=20
REGISTER_LIMIT_PER_DAY=10

# Optional deployment settings read by scripts/init_linux.sh.
CONDA_ENV_NAME=nethub-accounts
PYTHON_VERSION=3.12
SYSTEMD_SERVICE_NAME=nethub-accounts
